<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- 129857 - Rui Fernandes -->
<module name="Checker">
    <module name="TreeWalker">
        <!-- Regra para nomes de constantes (MAIÚSCULAS_COM_UNDERSCORES) -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
            <property name="message" value="A constante ''{0}'' deve estar em MAIÚSCULAS separadas por underscore (ex: MAX_SHIPS)."/>
        </module>
    </module>
</module>
